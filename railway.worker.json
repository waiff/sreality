{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "env MALLOC_ARENA_MAX=2 python -m scraper.realtime_worker",
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 30
  }
}
